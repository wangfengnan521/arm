<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>x5a_handeye</name>
  <version>0.1.0</version>
  <description>Eye-to-hand calibration for ARX X5A with fixed RealSense and board on tool.</description>
  <maintainer email="user@example.com">x5a user</maintainer>
  <license>BSD</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>image_transport</depend>
  <depend>realsense2_camera</depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
